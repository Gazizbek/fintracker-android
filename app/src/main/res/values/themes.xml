<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FinTrackerAndroid" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Launch theme: logo without the launcher icon's white background, on the app background color. -->
    <style name="Theme.FinTrackerAndroid.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.FinTrackerAndroid</item>
    </style>
</resources>
